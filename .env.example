UNIASSIST_ENV=development
DATABASE_URL=postgresql+asyncpg://uniassist:uniassist@postgres:5432/uniassist
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=uniassist-documents
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/hour
MAX_UPLOAD_BYTES=10485760
LLM_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=8
