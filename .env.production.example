UNIASSIST_ENV=production
DATABASE_URL=postgresql://uniassist:replace-me@postgres:5432/uniassist
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-generated-64-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET_DOCUMENTS=uniassist-documents
CORS_ORIGINS=https://portal.example.edu
ALLOWED_HOSTS=api.example.edu
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/hour
MAX_UPLOAD_BYTES=10485760
